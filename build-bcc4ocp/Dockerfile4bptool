FROM registry.redhat.io/openshift4/driver-toolkit-rhel9:v4.16

ENV PATH /usr/share/bcc/tools:$PATH
RUN subscription-manager register --username xxxxx --password xxxxxx 
RUN dnf install -y \
https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm
# Install bpftrace and bpftool, and their dependencies (bcc, python-bcc)
RUN dnf install -y \
    ca-certificates \
    perf \
    gcc \
    git \
    g++ \
    gdb \
    jq \
    golang \
    wget \
    strace \
    stress-ng \
    stress \
    perl-open \
    conntrack \
    glibc-common \
    bpftrace bpftool \
    tcpdump vim iproute \
    binutils \
    js-d3-flame-graph \
    libunwind \
    lsof \
    util-linux-core \
    coreutils-single \
    bind-utils procps-ng htop atop\
    elfutils-libelf-devel cmake3 git bison flex ncurses-devel \
    luajit luajit-devel python3 python3-bcc python3-pyroute2 iperf ethtool bison sysstat \
    flex \
    && dnf clean all

RUN mkdir /work
WORKDIR /work
COPY dump-process-memory-bypid.py /work
COPY dump-process-memory-bypid.sh /work
RUN git clone --depth 1 https://github.com/brendangregg/FlameGraph
RUN VERSION="v1.32.0"&& wget https://github.com/kubernetes-sigs/cri-tools/releases/download/$VERSION/crictl-$VERSION-linux-amd64.tar.gz && tar zxvf crictl-$VERSION-linux-amd64.tar.gz -C /usr/bin && rm -f crictl-$VERSION-linux-amd64.tar.gz
#https://0x.tools/
RUN git clone https://github.com/tanelpoder/0xtools.git && cd 0xtools && make && make install && make clean
ENTRYPOINT [ "/bin/bash"] 
